NODE_ENV=production
WEB_PORT=8080
DB_NAME=bambu_monitor
DB_USER=bambu_app
DB_PASSWORD=replace-with-unique-random-password
MYSQL_ROOT_PASSWORD=replace-with-another-unique-random-password
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=bambu-monitor
JWT_AUDIENCE=bambu-web
JWT_TTL_SECONDS=3600
COOKIE_SECURE=false
DISPLAY_TIMEZONE=Asia/Seoul
BOOTSTRAP_ADMIN_LOGIN=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-unique-initial-admin-password
SETTINGS_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
PRINTER_NAME=Studio X2D
PRINTER_HOST=
PRINTER_SERIAL=
PRINTER_ACCESS_CODE=
MQTT_PORT=
MQTT_USERNAME=
MQTT_REPORT_TOPIC=
MQTT_CA_PATH=
CAMERA_SOURCE_URL=
STATUS_STALE_SECONDS=60
RESERVATION_SLOT_MINUTES=30
RESERVATION_MAX_HOURS=24
RESERVATION_HORIZON_DAYS=30
JOB_LINK_WINDOW_MINUTES=10
LOG_LEVEL=info
